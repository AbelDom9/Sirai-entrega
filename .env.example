# API del equipo: login y datos. No incluir secretos en variables VITE_.
# Las rutas de la API de Capi empiezan con /api (por ejemplo /api/infantes).
VITE_BACKEND=https://localhost:3000/api
# Compatibilidad con la configuración anterior, si no se define VITE_BACKEND:
# VITE_SIMPLE_REST_URL=https://localhost:3000/api
